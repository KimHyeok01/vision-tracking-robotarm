<?xml version="1.0"?>
<robot name="robot_arm_description">

  <!-- base -->
  <link name="base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base.stl"/>
      </geometry>
      <material name="base_color">
        <color rgba="0.6 0.8 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- servo1 -->
  <link name="servo1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/servo1.stl"/>
      </geometry>
      <material name="servo_color">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/servo1.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_servo1" type="fixed">
    <parent link="base"/>
    <child link="servo1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- rotate_base -->
  <link name="rotate_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/rotate_base.stl"/>
      </geometry>
      <material name="rotate_base_color">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/rotate_base.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="servo1_to_rotate_base" type="fixed">
    <parent link="servo1"/>
    <child link="rotate_base"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- joint -->
  <link name="joint">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/joint.stl"/>
      </geometry>
      <material name="joint_color">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/joint.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="rotate_base_to_joint" type="fixed">
    <parent link="rotate_base"/>
    <child link="joint"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- link1 -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link1.stl"/>
      </geometry>
      <material name="link1_color">
        <color rgba="0.9 0.6 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link1.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_to_link1" type="fixed">
    <parent link="joint"/>
    <child link="link1"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- link2 -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link2.stl"/>
      </geometry>
      <material name="link2_color">
        <color rgba="0.3 0.7 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link2.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="link1_to_link2" type="fixed">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- link2__2 -->
  <link name="link2_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link2__2.stl"/>
      </geometry>
      <material name="link2_2_color">
        <color rgba="0.3 0.9 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/link2__2.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="link2_to_link2_2" type="fixed">
    <parent link="link2"/>
    <child link="link2_2"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

</robot>
